<misterromdescription>
    <name>MTV Rock-N-Roll Trivia</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>MTV Rock-N-Roll Trivia</series>
    <year>1986</year>
    <manufacturer>Triumph Software Inc.</manufacturer>
    <category>Maze</category>

    <setname>rocktrv2</setname>
    <parent>rocktrv2</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,F3,FF">
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,3,2,0"/>
        <dip name="Questions Per Game" bits="18,20" ids="2,3,4,5,6,7,8,9" values="7,6,5,4,3,2,1,0"/>
        <dip name="Clock Speed" bits="21,22" ids="Beginner,Intermed,Pro,Super - Pro" values="3,2,1,0"/>
        <dip name="Freeze Image" bits="23" ids="Off,On" values="1,0"/>
        <dip name="Mode" bits="24" ids="Amusement,Credit" values="1,0"/>
        <dip name="Cabinet" bits="25" ids="Upright,Cocktail" values="1,0"/>
        <dip name="K.O. Switch" bits="26" ids="Auto,Manual" values="1,0"/>
        <dip name="Service Mode" bits="27" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="28,30" ids="10000,17500,25000,32500,40000,47500,55000,62500" values="7,6,5,4,3,2,1,0"/>
        <dip name="Music" bits="31" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="rocktrv2.zip">
        <part crc="d182947b" name="1.aux"/>
        <part repeat="0x2000">00</part>
        <part crc="27a7461d" name="2.aux"/>
        <part repeat="0x8000">00</part>
        <part crc="0a6cc43b" name="5e.cpu" offset="0x0" length="0x1000"/>
        <part crc="0a6cc43b" name="5e.cpu" offset="0x0" length="0x1000"/>
        <part repeat="0x2000">00</part>
        <part crc="7549a947" name="7f.cpu"/>
        <part crc="ddd5d88e" name="4a.cpu"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
    </rom>

    <!-- Index 2: SDRAM (large banked ROM regions) -->
    <rom index="2" md5="none" zip="rocktrv2.zip">
        <part crc="5b117ca6" name="3.aux"/>
        <part crc="81bfd4c3" name="4.aux"/>
        <part crc="e976423c" name="5.aux"/>
        <part crc="425946bf" name="6.aux"/>
        <part crc="7056fc8f" name="7.aux"/>
        <part crc="8b86464f" name="8.aux"/>
        <part crc="17d8eba4" name="9.aux"/>
        <part crc="398c8eb4" name="10.aux"/>
        <part crc="7f376424" name="11.aux"/>
        <part crc="8d5bbf81" name="12.aux"/>
        <part crc="99fe2c21" name="13.aux"/>
        <part crc="df4cf5e7" name="14.aux"/>
        <part crc="2a32de26" name="15.aux"/>
        <part crc="fcd42187" name="16.aux"/>
        <part crc="24d5c388" name="17.aux"/>
        <part crc="feb195fd" name="18.aux"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            1B 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 12 15 09 0B 0C 0A 00 13 14 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
