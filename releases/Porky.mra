<misterromdescription>
    <name>Porky</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Porky</series>
    <year>1985</year>
    <manufacturer>Shinkai Inc. (Magic Electronics Inc. license)</manufacturer>
    <category>Maze</category>

    <setname>porky</setname>
