<misterromdescription>
    <name>Birdiy</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Birdiy</series>
    <year>1983</year>
    <manufacturer>Mama Top</manufacturer>
    <category>Maze</category>

    <setname>birdiy</setname>
    <parent>birdiy</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,E9,00">
        <dip name="Test mode?" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,4"/>
        <dip name="Cabinet" bits="20" ids="Upright,Cocktail"/>
        <dip name="Skip Screen" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="22" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="birdiy.zip">
        <part crc="3a58f8ad" name="a6.6a"/>
        <part crc="fec61ea2" name="c6.6c"/>
        <part crc="3392783b" name="a4.4a"/>
        <part crc="2391d83d" name="c4.4c"/>
        <part repeat="0xC000">00</part>
        <part crc="8f6bf54f" name="c1.1c"/>
        <part crc="10b55440" name="c3.3c"/>
        <part repeat="0x2000">00</part>
        <part crc="ff344446" name="n82s123n.10n"/>
        <part crc="63efb927" name="n82s129n.9m"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="n82s129n.4k"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            19 11 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 12 16 09 0B 0C 0A 05 13 14 0D
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            09 92 17 3B 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4C 29 00 1E 00 00
            00 00 C3 ED 00 06 30 20
            00 00 4D 03 00 03 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="39"></nvram>

    <remark>Birdiy (Mama Top)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
