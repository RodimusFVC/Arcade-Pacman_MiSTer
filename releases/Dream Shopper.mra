<misterromdescription>
    <name>Dream Shopper</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Dream Shopper</series>
    <year>1982</year>
    <manufacturer>Sanritsu</manufacturer>
    <category>Maze</category>

    <setname>dremshpr</setname>
    <parent>dremshpr</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF,00">
        <dip name="Cabinet" bits="16" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Flip Screen" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="18,19" ids="30000,50000,70000,None" values="2,1,0,3"/>
        <dip name="Lives" bits="20,21" ids="3,4,5,6" values="3,2,1,0"/>
        <dip name="Coinage" bits="22,23" ids="2C/1C,1C/1C,1C/2C,1C/3C" values="0,3,2,1"/>
        <dip name="Invulnerability (Cheat)" bits="24" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="dremshpr.zip">
        <part crc="830c6361" name="red_1.50"/>
        <part crc="d22551cc" name="red_2.51"/>
        <part crc="0713a34a" name="red_3.52"/>
        <part crc="f38bcaaa" name="red_4.53"/>
        <part repeat="0x4000">00</part>
        <part crc="6a382267" name="red_5.39"/>
        <part crc="4cf8b121" name="red_6.40"/>
        <part crc="bd4fc4ba" name="red_7.41"/>
        <part repeat="0x5000">00</part>
        <part crc="2d6698dc" name="red-20.18"/>
        <part crc="38c9ce9b" name="red-21.19"/>
        <part repeat="0x2000">00</part>
        <part crc="ce1d9503" name="6331-1.6"/>
        <part crc="39d6fb5c" name="6301-1.37"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            12 13 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 05 11 00 12 09 0B 0C 0A 0D 13 14 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 62 FE 5A 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4C 00 00 F0 00 01
            00 00 48 08 00 06 00 00
            00 00 48 09 00 01 03 03
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="247"></nvram>

    <remark>Dream Shopper (Sanritsu)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
