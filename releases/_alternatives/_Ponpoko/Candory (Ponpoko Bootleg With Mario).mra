<misterromdescription>
    <name>Candory (Ponpoko Bootleg With Mario)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ponpoko</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Maze</category>

    <setname>candory</setname>
    <parent>ponpoko</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="E0,00,E1,B1">
        <dip name="Bonus Life" bits="16,17" ids="10000,30000,50000,None" values="1,2,3,0"/>
        <dip name="Unknown" bits="18,19" ids="0,1,2,3"/>
        <dip name="Lives" bits="20,21" ids="2,3,4,5"/>
        <dip name="Cabinet" bits="22" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="24,27" ids="A 3/1 B 3/1,A 3/1 B 1/2,A 3/1 B 1/4,A 2/1 B 2/1,A 2/1 B 1/1,A 2/1 B 1/3,A 2/1 B 1/5,A 2/1 B 1/6,A 1/1 B 1/1,A 1/1 B 4/5,A 1/1 B 2/3,A 1/1 B 1/3,A 1/1 B 1/5,A 1/1 B 1/6,A 1/2 B 1/2,Free Play" values="4,14,15,2,13,7,11,12,1,6,5,10,8,9,3,0"/>
        <dip name="Unknown" bits="28" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="29" ids="Off,On" values="1,0"/>
        <dip name="Demo Sounds" bits="30" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="31" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="candory.zip|ponpoko.zip">
        <part crc="ffa3c004" name="ppokoj1.bin"/>
        <part crc="4a496866" name="ppokoj2.bin"/>
        <part crc="17da6ca3" name="ppokoj3.bin"/>
        <part crc="9d39a565" name="ppokoj4.bin"/>
        <part repeat="0x4000">00</part>
        <part crc="54ca3d7d" name="ppoko5.bin"/>
        <part crc="3055c7e0" name="ppoko6.bin"/>
        <part crc="3cbe47ca" name="ppoko7.bin"/>
        <part crc="04b63fc6" name="ppokoj8.bin"/>
        <part repeat="0x4000">00</part>
        <part crc="7d16bdff" name="candory.v2"/>
        <part crc="e08ac188" name="candory.v1"/>
        <part repeat="0x2000">00</part>
        <part crc="2fc650bd" name="82s123.7f"/>
        <part crc="3eb3a8e4" name="82s126.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            04 03 00 02 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 05 11 12 16 09 0B 0C 0A 0D 13 14 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            16 6D A0 76 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4C 40 00 03 00 00
            00 00 4E 5A 00 13 00 00
            00 00 40 6C 00 06 0F 00
            00 00 4C 53 00 01 02 02
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="29"></nvram>

    <remark>Candory (Ponpoko Bootleg With Mario)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
