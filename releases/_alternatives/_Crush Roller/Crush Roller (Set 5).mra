        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="3,4,5,6"/>
        <dip name="First Pattern" bits="20" ids="Easy,Hard" values="1,0"/>
        <dip name="Teleport Holes" bits="21" ids="Off,On" values="1,0"/>
    </switches>

