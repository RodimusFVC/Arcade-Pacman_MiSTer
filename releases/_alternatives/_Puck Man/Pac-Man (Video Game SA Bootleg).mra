<misterromdescription>
    <name>Pac-Man (Video Game SA Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pac-Man</series>
    <year>1980</year>
    <manufacturer>bootleg (Video Game SA)</manufacturer>
    <category>Maze</category>

    <setname>pacmanvg</setname>
    <parent>puckman</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,C9,00">
        <dip name="Rack Test (Cheat)" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,5"/>
        <dip name="Bonus Life" bits="20,21" ids="10000,15000,20000,None"/>
        <dip name="Difficulty" bits="22" ids="Normal,Hard" values="1,0"/>
        <dip name="Ghost Names" bits="23" ids="Normal,Alternate" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="pacmanvg.zip|puckman.zip">
        <part crc="76dbed21" name="pm-1r.6e"/>
        <part crc="965bb9b2" name="pm-5r.6k"/>
        <part crc="7d177853" name="pm-2r.6f"/>
        <part crc="d3e8914c" name="pm-6r.6m"/>
        <part crc="a5af382c" name="pm-3r.6h"/>
        <part crc="a948ce83" name="pm-7r.6n"/>
        <part crc="7c42d9be" name="pm-4r.6j"/>
        <part crc="68a7300d" name="pm-8r.6p"/>
        <part repeat="0xC000">00</part>
        <part crc="2229ab07" name="pm-9s.5e"/>
        <part crc="3591b89d" name="pm-11s.5h"/>
        <part crc="9e39323a" name="pm-10s.5f"/>
        <part crc="1b1d9096" name="pm-12s.5j"/>
        <part repeat="0x2000">00</part>
        <part crc="2fc650bd" name="pm1-1.7f"/>
        <part crc="3eb3a8e4" name="pm1-4.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="pm1-3.1m"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            00 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 25 11 12 16 09 0B 0C 0A 00 13 14 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            0E 8C A2 06 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4E 88 00 04 00 00
            00 00 43 ED 00 06 40 40
            00 00 43 D1 00 01 45 45
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="11"></nvram>

    <remark>Pac-Man (Video Game SA Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
