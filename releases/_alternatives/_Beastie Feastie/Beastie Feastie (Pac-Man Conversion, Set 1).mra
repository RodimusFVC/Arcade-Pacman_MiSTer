<misterromdescription>
    <name>Beastie Feastie (Pac-Man Conversion, Set 1)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Beastie Feastie</series>
    <year>1984</year>
    <manufacturer>Epos Corporation</manufacturer>
    <category>Maze</category>

    <setname>beastfp</setname>
    <parent>suprglob</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,DF,00">
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,6" values="3,2,1,0"/>
        <dip name="Difficulty" bits="18,20" ids="Easiest,Very Easy,Easy,Normal,Difficult,Very Difficult,Very Hard,Hardest" values="7,6,5,4,3,2,1,0"/>
        <dip name="Demo Sounds" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="22" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="beastfp.zip|suprglob.zip">
        <part crc="3afc517b" name="bf-u2.bin"/>
        <part crc="8dbd76d0" name="bf-u3.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="5654dc34" name="beastf.5e"/>
        <part crc="1b30ca61" name="beastf.5f"/>
        <part repeat="0x2000">00</part>
        <part crc="1f617527" name="7_f_the_glob.7f"/>
        <part crc="28faa769" name="4_a_the_glob.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            0B 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 00 0E 09 0B 0C 0A 0D 05 06 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Beastie Feastie (Pac-Man Conversion, Set 1) (Epos Corporation)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
