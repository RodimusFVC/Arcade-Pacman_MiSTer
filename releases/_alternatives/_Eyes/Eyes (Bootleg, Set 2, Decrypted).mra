<misterromdescription>
    <name>Eyes (Bootleg, Set 2, Decrypted)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Eyes</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Maze</category>

    <setname>eyeszacb</setname>
    <parent>eyes</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FB,00">
        <dip name="Service Mode" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,3,2,0"/>
        <dip name="Lives" bits="18,19" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Bonus Life" bits="20,21" ids="50000,75000,100000,125000" values="3,2,1,0"/>
        <dip name="Cabinet" bits="22" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="eyeszacb.zip|eyes.zip">
