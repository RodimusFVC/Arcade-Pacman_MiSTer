<misterromdescription>
    <name>Super ABC (Pac-Man Multigame Kit, Mar. 08 1999)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Super ABC</series>
    <year>1999</year>
    <manufacturer>hack (Two-Bit Score)</manufacturer>
    <category>Maze</category>

    <setname>superabco</setname>
    <parent>superabc</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,C9,00">
        <dip name="Rack Test (Cheat)" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,5"/>
        <dip name="Difficulty" bits="22" ids="Normal,Hard" values="1,0"/>
        <dip name="Bonus Life" bits="20,21" ids="10000; Allow Continue,15000; Allow Continue,20000; No Continue,None; No Continue"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="superabco.zip|superabc.zip">
        <part repeat="0x14000">00</part>
        <part crc="3a188666" name="82s123.7f"/>
        <part crc="4382c049" name="82s129.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
        <part repeat="0xB700">00</part>
        <part crc="45caace0" name="char5e5f.u1"/>
    </rom>

    <!-- Index 2: SDRAM (large banked ROM regions) -->
    <rom index="2" md5="none" zip="superabco.zip|superabc.zip">
        <part crc="62565ad8" name="superabco.u14"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            1D 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 25 11 12 16 09 0B 0C 0A 00 13 14 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Super ABC (Pac-Man Multigame Kit, Mar. 08 1999) (Hack (Two-Bit Score))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
