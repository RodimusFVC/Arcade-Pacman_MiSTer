<misterromdescription>
    <name>Ms Pac Man Twin (Argentina, Set 2)</name>
    <region>Argentina</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ms Pac Man Twin</series>
    <year>1992</year>
    <manufacturer>hack (Susilu)</manufacturer>
    <category>Maze</category>

    <setname>mspactwina</setname>
    <parent>mspactwin</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,C9,FF">
        <dip name="Speed" bits="4" ids="Slow,Fast" values="1,0"/>
        <dip name="Rack Test (Cheat)" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play (Invalid)" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,5"/>
        <dip name="Bonus Life" bits="20,21" ids="10000,15000,20000,None"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="mspactwina.zip|mspactwin.zip">
        <part crc="a0fb55ba" name="6_db.u4" offset="0x0" length="0x4000"/>
        <part repeat="0x4000">00</part>
        <part crc="a0fb55ba" name="6_db.u4" offset="0x4000" length="0x4000"/>
        <part repeat="0x4000">00</part>
        <part crc="483c1d1c" name="1.5e"/>
        <part crc="703912f5" name="3.5h"/>
        <part crc="22b0188a" name="2.5f"/>
        <part crc="0a8c46a0" name="4.5j"/>
        <part repeat="0x2000">00</part>
        <part crc="ff344446" name="mb7051.8h"/>
        <part crc="a8202d0d" name="82s129.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="mb7052.1k"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            03 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 12 16 09 0B 0C 0A 16 13 14 25
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Ms Pac Man Twin (Argentina, Set 2) (Hack (Susilu))</remark>
