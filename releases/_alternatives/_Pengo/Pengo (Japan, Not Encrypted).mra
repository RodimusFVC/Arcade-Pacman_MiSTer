<misterromdescription>
    <name>Pengo (Japan, Not Encrypted)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pengo</series>
    <year>1982</year>
    <manufacturer>Sega</manufacturer>
    <category>Maze</category>

    <setname>pengoj</setname>
    <parent>pengo</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,B0,CC">
        <dip name="Bonus Life" bits="16" ids="30000,50000"/>
        <dip name="Demo Sounds" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="18" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="19,20" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Rack Test (Cheat)" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="22,23" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Coin A" bits="24,27" ids="4C/1C,3C/1C,2C/1C,2 Coins/1 Credit 5/3,2 Coins/1 Credit 4/3,1C/1C,1 Coin/1 Credit 5/6,1 Coin/1 Credit 4/5,1 Coin/1 Credit 2/3,1C/2C,1 Coin/2 Credits 5/11,1 Coin/2 Credits 4/9,1C/3C,1C/4C,1C/5C,1C/6C" values="0,8,4,9,5,12,13,3,11,2,7,15,10,6,14,1"/>
        <dip name="Coin B" bits="28,31" ids="4C/1C,3C/1C,2C/1C,2 Coins/1 Credit 5/3,2 Coins/1 Credit 4/3,1C/1C,1 Coin/1 Credit 5/6,1 Coin/1 Credit 4/5,1 Coin/1 Credit 2/3,1C/2C,1 Coin/2 Credits 5/11,1 Coin/2 Credits 4/9,1C/3C,1C/4C,1C/5C,1C/6C" values="0,8,4,9,5,12,13,3,11,2,7,15,10,6,14,1"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="pengoj.zip|pengo.zip">
        <part crc="f01afb60" name="epr-5120.ic8"/>
