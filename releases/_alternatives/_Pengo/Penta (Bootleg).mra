        <part crc="6afeba9d" name="092_pn09.bin" offset="0x1000" length="0x1000"/>
        <part crc="5bfd26e9" name="105_pn10.bin" offset="0x1000" length="0x1000"/>
        <part crc="3a5844ec" name="pr1633.ic78"/>
