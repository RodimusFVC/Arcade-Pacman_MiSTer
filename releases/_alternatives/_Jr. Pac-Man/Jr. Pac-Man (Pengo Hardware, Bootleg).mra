<misterromdescription>
    <name>Jr. Pac-Man (Pengo Hardware, Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Jr. Pac-Man</series>
    <year>1983</year>
    <manufacturer>bootleg</manufacturer>
    <category>Maze</category>

    <setname>jrpacmbl</setname>
    <parent>jrpacman</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,C9,FF">
        <dip name="Service Mode" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,5"/>
        <dip name="Bonus Life" bits="20,21" ids="10000,15000,20000,30000"/>
        <dip name="Rack Test (Cheat)" bits="22" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="23" ids="Upright,Cocktail" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="jrpacmbl.zip|jrpacman.zip">
        <part crc="98049df4" name="jrpacpe-05.ic8"/>
        <part crc="b7a5cef8" name="jrpacpe-01.ic7"/>
        <part crc="ecf39785" name="jrpacpe-06.ic6"/>
        <part crc="c090145c" name="jrpacpe-02.ic5"/>
        <part crc="659b9956" name="jrpacpe-07.ic4"/>
        <part crc="0ebcfac9" name="jrpacpe-03.ic3"/>
        <part crc="0624ffd6" name="jrpacpe-08.ic2"/>
        <part crc="d3a8448c" name="jrpacpe-04.ic1"/>
        <part repeat="0x8000">00</part>
        <part crc="2128d9b4" name="jrpacpe-09.ic92"/>
        <part crc="73477193" name="jrpacpe-10.ic105"/>
        <part repeat="0x20">00</part>
        <part crc="9f6ea9d8" name="jrprom.9p"/>
        <part repeat="0x4E0">00</part>
        <part crc="029d35c4" name="jrprom.9e"/>
        <part crc="eee34a79" name="jrprom.9f"/>
        <part crc="a9cc86bf" name="jrprom.7p"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            18 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 02 03 04 11 12 17 00 09 0A 0B 0C 00 13 14 00
            00 00 00 00 00 00 24 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            11 B0 F4 A3 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 8E 88 00 03 00 00
            00 00 87 6D 00 06 40 40
            00 00 8D CE 00 01 03 03
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="10"></nvram>

    <remark>Jr. Pac-Man (Pengo Hardware, Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
