        <part crc="03905a76" name="2.bin" offset="0x6C0E" length="0x13F2"/>
        <part repeat="0x4000">00</part>
        <part crc="8ee4a3b0" name="1.bin" offset="0x0" length="0x800"/>
        <part crc="8ee4a3b0" name="1.bin" offset="0x1000" length="0x800"/>
        <part crc="8ee4a3b0" name="1.bin" offset="0x800" length="0x800"/>
        <part crc="8ee4a3b0" name="1.bin" offset="0x1800" length="0x800"/>
