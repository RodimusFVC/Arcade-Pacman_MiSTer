        <part crc="0a91fe67" name="7.5e" offset="0x0" length="0x800"/>
        <part crc="112b5ed2" name="8.5f" offset="0x0" length="0x800"/>
        <part crc="0a91fe67" name="7.5e" offset="0x800" length="0x800"/>
        <part crc="112b5ed2" name="8.5f" offset="0x800" length="0x800"/>
        <part repeat="0x2000">00</part>
