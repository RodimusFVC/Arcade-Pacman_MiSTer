<misterromdescription>
    <name>Ms. Pac-Man (Novatronic Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ms. Pac-Man</series>
    <year>1981</year>
