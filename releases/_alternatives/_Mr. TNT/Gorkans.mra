<misterromdescription>
    <name>Gorkans</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mr. TNT</series>
    <year>1983</year>
    <manufacturer>Techstar</manufacturer>
    <category>Maze</category>

    <setname>gorkans</setname>
    <parent>mrtnt</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,FB,00">
        <dip name="Service Mode" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,3,2,0"/>
        <dip name="Lives" bits="18,19" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Bonus Life" bits="20,21" ids="75000,100000,125000,150000" values="3,2,1,0"/>
        <dip name="Cabinet" bits="22" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14400 -->
    <rom index="0" md5="none" zip="gorkans.zip|mrtnt.zip">
        <part crc="55100b18" name="gorkans8.rom"/>
        <part crc="b5c604bf" name="gorkans4.rom"/>
        <part crc="b8c6def4" name="gorkans7.rom"/>
        <part crc="4602c840" name="gorkans3.rom"/>
        <part crc="21412a62" name="gorkans6.rom"/>
        <part crc="a013310b" name="gorkans2.rom"/>
        <part crc="122969b2" name="gorkans5.rom"/>
        <part crc="f2524b11" name="gorkans1.rom"/>
        <part repeat="0xC000">00</part>
        <part crc="39cd0dbc" name="gorkgfx4.rom"/>
        <part crc="33d52535" name="gorkgfx2.rom"/>
        <part crc="4b6b7970" name="gorkgfx3.rom"/>
        <part crc="ed70bb3c" name="gorkgfx1.rom"/>
        <part repeat="0x2000">00</part>
        <part crc="2fc650bd" name="gorkprom.4"/>
        <part crc="3eb3a8e4" name="gorkprom.1"/>
        <part repeat="0x2E0">00</part>
        <part crc="a9cc86bf" name="gorkprom.3"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            00 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 15 12 09 0B 0C 0A 05 13 14 0D
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Gorkans (Techstar)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
