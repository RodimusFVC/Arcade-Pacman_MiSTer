<misterromdescription>
    <name>Mustafa And 40 Thieves (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ali Baba And 40 Thieves</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Maze</category>

    <setname>alibabab</setname>
    <parent>alibaba</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,C9,FF">
        <dip name="Rack Test (Cheat)" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,1,2,0"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,5"/>
        <dip name="Bonus Life" bits="20,21" ids="10000,15000,20000,None"/>
        <dip name="Difficulty" bits="22" ids="Normal,Hard" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="alibabab.zip|alibaba.zip">
        <part crc="38d701aa" name="6e"/>
        <part crc="3d0e35f3" name="6f"/>
        <part crc="823bee89" name="6h"/>
        <part crc="474d032f" name="6k"/>
        <part repeat="0x4000">00</part>
        <part crc="ae2f4aac" name="ab5.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="438d0357" name="6m"/>
        <part repeat="0x5800">00</part>
        <part crc="85bcb8f8" name="5e"/>
        <part crc="38e50862" name="5h"/>
        <part crc="b5715c86" name="5f"/>
        <part crc="713086b3" name="5k"/>
        <part repeat="0x2000">00</part>
        <part crc="2fc650bd" name="82s123.e7"/>
        <part crc="3eb3a8e4" name="82s129.a4"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
        <part repeat="0x700">00</part>
        <part crc="52294ef5" name="ab7.bin" offset="0x0" length="0x800"/>
        <part crc="52294ef5" name="ab7.bin" offset="0x0" length="0x800"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
