<misterromdescription>
    <name>Lizard Wizard</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Lizard Wizard</series>
    <year>1985</year>
    <manufacturer>Techstar (Sunn license)</manufacturer>
    <category>Maze</category>

    <setname>lizwiz</setname>
    <parent>lizwiz</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FB,00">
        <dip name="Service Mode" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,3,2,0"/>
        <dip name="Lives" bits="18,19" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Bonus Life" bits="20,21" ids="75000,100000,125000,150000" values="3,2,1,0"/>
        <dip name="Difficulty" bits="22" ids="Normal,Hard" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="lizwiz.zip">
        <part crc="32bc1990" name="6e.cpu"/>
        <part crc="ef24b414" name="6f.cpu"/>
        <part crc="30bed83d" name="6h.cpu"/>
        <part crc="dd09baeb" name="6j.cpu"/>
        <part repeat="0x4000">00</part>
        <part crc="f6dea3a6" name="wiza"/>
        <part crc="f27fb5a8" name="wizb"/>
        <part repeat="0x6000">00</part>
        <part crc="45059e73" name="5e.cpu"/>
        <part crc="d2469717" name="5f.cpu"/>
        <part repeat="0x2000">00</part>
        <part crc="7549a947" name="7f.cpu"/>
        <part crc="5fdca536" name="4a.cpu"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            04 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 15 12 09 0B 0C 0A 05 13 14 0D
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4D AF 00 3C 4D 01
            00 00 43 ED 00 06 00 40
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="66"></nvram>

    <remark>Lizard Wizard (Techstar (Sunn License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
