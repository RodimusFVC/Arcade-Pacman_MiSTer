<misterromdescription>
    <name>Eggor</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Eggor</series>
    <year>1983</year>
    <manufacturer>Telko</manufacturer>
    <category>Maze</category>

    <setname>eggor</setname>
    <parent>eggor</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FB,00">
        <dip name="Service Mode" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,3,2,0"/>
        <dip name="Lives" bits="18,19" ids="2,3,4,5" values="3,2,1,0"/>
        <dip name="Bonus Life" bits="20,21" ids="75000,100000,125000,150000" values="3,2,1,0"/>
        <dip name="Cabinet" bits="22" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="eggor.zip">
        <part crc="818ed154" name="1.bin"/>
        <part crc="a4b21d93" name="5.bin"/>
        <part crc="5d7a23ed" name="2.bin"/>
        <part crc="e9dbca8d" name="6.bin"/>
        <part crc="4318ab85" name="3.bin"/>
        <part crc="03214d7f" name="7.bin"/>
        <part crc="dc805be4" name="4.bin"/>
        <part crc="f9ae204b" name="8.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="96ad8626" name="9.bin"/>
        <part crc="cc324017" name="11.bin"/>
        <part crc="7c97f513" name="10.bin"/>
        <part crc="2e930602" name="12.bin"/>
        <part repeat="0x2000">00</part>
        <part crc="2fc650bd" name="82s123.7f"/>
        <part crc="3eb3a8e4" name="82s126.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            00 91 01 01 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 15 12 09 0B 0C 0A 05 13 14 0D
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4C F7 00 3C 4C 00
            00 00 4D 31 00 01 52 52
            00 00 43 ED 00 06 00 40
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="67"></nvram>

    <remark>Eggor (Telko)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
