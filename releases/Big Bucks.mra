<misterromdescription>
    <name>Big Bucks</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Big Bucks</series>
    <year>1986</year>
    <manufacturer>Dynasoft Inc.</manufacturer>
    <category>Maze</category>

    <setname>bigbucks</setname>
    <parent>bigbucks</parent>
    <mameversion>0289</mameversion>
    <rbf>Pacman</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FF,3C,00">
        <dip name="Enable Category Adult Affairs" bits="4" ids="Off,On"/>
        <dip name="Time to bet / answer" bits="16" ids="15 sec. / 10 sec.,20 sec. / 15 sec."/>
        <dip name="Continue if player busts" bits="17" ids="Off,On"/>
        <dip name="Show correct answer" bits="18" ids="Off,On"/>
        <dip name="Demo Sounds" bits="19" ids="Off,On"/>
        <dip name="Coinage" bits="20" ids="2C/1C,1C/1C"/>
        <dip name="Cabinet" bits="21" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Unknown" bits="22" ids="Off,On"/>
        <dip name="Unknown" bits="23" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x0000, gfx 0x10000, PROMs 0x14000, waveform PROM 0x14800 -->
    <rom index="0" md5="none" zip="bigbucks.zip">
        <part crc="eea6c1c9" name="p.rom"/>
        <part repeat="0x4000">00</part>
        <part crc="bb8f7363" name="m.rom"/>
        <part repeat="0x6000">00</part>
        <part crc="18442c37" name="5e.cpu" offset="0x0" length="0x1000"/>
        <part crc="18442c37" name="5e.cpu" offset="0x0" length="0x1000"/>
        <part repeat="0x2000">00</part>
        <part crc="2fc650bd" name="82s123.7f"/>
        <part crc="3eb3a8e4" name="82s126.4a"/>
        <part repeat="0x6E0">00</part>
        <part crc="a9cc86bf" name="82s126.1m"/>
    </rom>

    <!-- Index 2: SDRAM (large banked ROM regions) -->
    <rom index="2" md5="none" zip="bigbucks.zip">
        <part crc="90b7785f" name="rom1.rom"/>
        <part crc="60172d77" name="rom2.rom"/>
        <part crc="a2207320" name="rom3.rom"/>
        <part crc="5a74c1f9" name="rom4.rom"/>
        <part crc="93bc1080" name="rom5.rom"/>
        <part crc="eea2423f" name="rom6.rom"/>
        <part crc="96694055" name="rom7.rom"/>
        <part crc="e68ebf8e" name="rom8.rom"/>
        <part crc="fd20921d" name="rom9.rom"/>
        <part crc="5091b951" name="rom10.rom"/>
        <part crc="705128db" name="rom11.rom"/>
        <part crc="74c776e7" name="rom12.rom"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Pacman.sv) -->
    <rom index="1">
        <part>
            1C 91 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 03 04 02 00 11 12 16 09 0B 0C 0A 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 4A 3E C4 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 4D 7F 00 5F 48 00
            00 00 4D DC 00 01 20 20
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="96"></nvram>

    <remark>Big Bucks (Dynasoft Inc.)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
